{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/content-runtime/twin.schema.json",
  "title": "Pipeline Output: twin",
  "allOf": [
    {
      "$ref": "common.json"
    }
  ],
  "description": "twin 步骤输出文件。body 必须包含内容元信息、DNA、结构、表达、读者画像、风格一致性、可复用模式、禁区建议、观察结论和 Twin 记忆写入计划。",
  "properties": {
    "body": {
      "type": "string",
      "minLength": 1,
      "description": "markdown 正文",
      "allOf": [
        {
          "pattern": "(?m)^##\\s*1\\.\\s+内容元信息"
        },
        {
          "pattern": "(?m)^##\\s*2\\.\\s+内容\\s+DNA\\s+提取"
        },
        {
          "pattern": "(?m)^##\\s*3\\.\\s+结构模式识别"
        },
        {
          "pattern": "(?m)^##\\s*4\\.\\s+表达特征提取"
        },
        {
          "pattern": "(?m)^##\\s*5\\.\\s+读者画像观察"
        },
        {
          "pattern": "(?m)^##\\s*6\\.\\s+风格一致性评分"
        },
        {
          "pattern": "(?m)^##\\s*7\\.\\s+可复用模式归档"
        },
        {
          "pattern": "(?m)^##\\s*8\\.\\s+禁区/禁忌更新建议"
        },
        {
          "pattern": "(?m)^##\\s*9\\.\\s+观察结论"
        },
        {
          "pattern": "(?m)^##\\s*9\\.1\\s+.*记忆(?:写入计划|更新索引)"
        }
      ]
    }
  }
}
