{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/content-runtime/compliance.schema.json",
  "title": "Pipeline Output: compliance",
  "allOf": [
    {
      "$ref": "common.json"
    }
  ],
  "description": "compliance 步骤输出文件。body 必须包含检查对象、违禁词、广告法、平台规则、版权、授权与引流台账、修改清单和综合判断。",
  "properties": {
    "body": {
      "type": "string",
      "minLength": 1,
      "description": "markdown 正文",
      "allOf": [
        {
          "pattern": "(?m)^##\\s*0\\.\\s+检查对象"
        },
        {
          "pattern": "(?m)^##\\s*1\\.\\s+违禁词扫描"
        },
        {
          "pattern": "(?m)^##\\s*2\\.\\s+广告法敏感词"
        },
        {
          "pattern": "(?m)^##\\s*3\\.\\s+平台规则风险"
        },
        {
          "pattern": "(?m)^##\\s*4\\.\\s+版权风险"
        },
        {
          "pattern": "(?m)^##\\s*4\\.1\\s+授权与引流证据台账"
        },
        {
          "pattern": "(?m)^##\\s*5\\.\\s+修改清单"
        },
        {
          "pattern": "(?m)^##\\s*6\\.\\s+综合判断"
        }
      ]
    }
  }
}
