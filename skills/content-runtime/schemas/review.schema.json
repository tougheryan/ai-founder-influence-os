{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/content-runtime/review.schema.json",
  "title": "Pipeline Output: review",
  "allOf": [
    {
      "$ref": "common.json"
    }
  ],
  "description": "review 步骤输出文件。body 必须包含内容元信息、表现记录、数据来源与口径、跨平台归因、评论洞察、用户问题归类、选题命中率、选题优化、下一条建议和洞察沉淀。",
  "properties": {
    "body": {
      "type": "string",
      "minLength": 1,
      "description": "markdown 正文",
      "allOf": [
        {
          "pattern": "(?m)^##\\s*0\\.\\s+内容元信息"
        },
        {
          "pattern": "(?m)^##\\s*1\\.\\s+表现记录"
        },
        {
          "pattern": "(?m)^###\\s*1\\.3\\s+数据来源与口径"
        },
        {
          "pattern": "(?m)^##\\s*2\\.\\s+跨平台归因"
        },
        {
          "pattern": "(?m)^##\\s*3\\.\\s+评论洞察"
        },
        {
          "pattern": "(?m)^##\\s*4\\.\\s+用户问题归类"
        },
        {
          "pattern": "(?m)^##\\s*5\\.\\s+选题命中率"
        },
        {
          "pattern": "(?m)^##\\s*6\\.\\s+选题优化"
        },
        {
          "pattern": "(?m)^##\\s*7\\.\\s+下一条建议"
        },
        {
          "pattern": "(?m)^##\\s*8\\.\\s+洞察沉淀"
        }
      ]
    }
  }
}
