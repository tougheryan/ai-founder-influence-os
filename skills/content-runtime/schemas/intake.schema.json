{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/content-runtime/intake.schema.json",
  "title": "Pipeline Output: intake",
  "allOf": [
    {
      "$ref": "common.json"
    }
  ],
  "description": "intake 步骤输出文件。body 必须包含素材资产包核心章节：场景、人物、事实场景、观点、情绪、案例、商业意图、不可公开信息、素材质量判断。",
  "properties": {
    "body": {
      "type": "string",
      "minLength": 1,
      "description": "markdown 正文",
      "allOf": [
        {
          "pattern": "(?m)^##\\s*0\\.\\s+素材场景"
        },
        {
          "pattern": "(?m)^##\\s*1\\.\\s+人物"
        },
        {
          "pattern": "(?m)^##\\s*2\\.\\s+场景"
        },
        {
          "pattern": "(?m)^##\\s*3\\.\\s+观点"
        },
        {
          "pattern": "(?m)^##\\s*4\\.\\s+情绪"
        },
        {
          "pattern": "(?m)^##\\s*5\\.\\s+案例"
        },
        {
          "pattern": "(?m)^##\\s*6\\.\\s+商业意图"
        },
        {
          "pattern": "(?m)^##\\s*7\\.\\s+不可公开信息"
        },
        {
          "pattern": "(?m)^##\\s*9\\.\\s+素材质量判断"
        }
      ]
    }
  }
}
