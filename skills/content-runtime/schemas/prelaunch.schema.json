{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/content-runtime/prelaunch.schema.json",
  "title": "Pipeline Output: prelaunch",
  "allOf": [
    {
      "$ref": "common.json"
    }
  ],
  "description": "prelaunch 步骤输出文件。body 必须包含检查对象、四层检查、共鸣诊断、发布资产准备度检查、待修复清单和综合判断。",
  "properties": {
    "body": {
      "type": "string",
      "minLength": 1,
      "description": "markdown 正文",
      "allOf": [
        {
          "pattern": "(?m)^##\\s*0\\.\\s+检查对象"
        },
        {
          "pattern": "(?m)^##\\s*1\\.\\s+事实层检查"
        },
        {
          "pattern": "(?m)^##\\s*2\\.\\s+风格层检查"
        },
        {
          "pattern": "(?m)^##\\s*3\\.\\s+平台规则层检查"
        },
        {
          "pattern": "(?m)^##\\s*4\\.\\s+商业闭环检查"
        },
        {
          "pattern": "(?m)^##\\s*5\\.\\s+共鸣诊断"
        },
        {
          "pattern": "(?m)^##\\s*5\\.2\\s+(?:发布资产准备度检查|交付资产准备度检查|资产准备度检查|发布准备度检查)"
        },
        {
          "pattern": "(?m)^##\\s*6\\.\\s+待修复清单"
        },
        {
          "pattern": "(?m)^##\\s*7\\.\\s+综合判断"
        }
      ]
    }
  }
}
