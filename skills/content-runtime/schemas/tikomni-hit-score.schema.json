{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "echo-founder.tikomni-hit-score.v5",
  "type": "object",
  "required": ["sample_class", "hit_score", "evidence_status", "confidence", "metric_completeness", "score_components", "score_version"],
  "properties": {
    "sample_class": {"enum": ["verified_hit", "potential", "related", "insufficient"]},
    "hit_score": {"type": "integer", "minimum": 0, "maximum": 100},
    "classification_reason": {"type": "string"},
    "evidence_status": {"enum": ["sufficient", "insufficient"]},
    "confidence": {"type": "integer", "minimum": 0, "maximum": 100},
    "metric_completeness": {"type": "number", "minimum": 0, "maximum": 1},
    "age_days": {"type": ["number", "null"]},
    "creator_baseline": {"type": ["number", "null"]},
    "creator_lift": {"type": ["number", "null"]},
    "engagement_rate": {"type": ["number", "null"]},
    "score_components": {
      "type": "object",
      "required": ["absolute_volume", "engagement_rate", "batch_percentile", "creator_lift", "performance", "relevance", "freshness", "evidence", "total"],
      "properties": {
        "absolute_volume": {"type": "number", "minimum": 0, "maximum": 100},
        "engagement_rate": {"type": "number", "minimum": 0, "maximum": 100},
        "batch_percentile": {"type": "number", "minimum": 0, "maximum": 100},
        "creator_lift": {"type": "number", "minimum": 0, "maximum": 100},
        "performance": {"type": "number", "minimum": 0, "maximum": 100},
        "relevance": {"type": "number", "minimum": 0, "maximum": 100},
        "freshness": {"type": "number", "minimum": 0, "maximum": 100},
        "evidence": {"type": "number", "minimum": 0, "maximum": 100},
        "total": {"type": "number", "minimum": 0, "maximum": 100}
      }
    },
    "score_version": {"const": "echo-founder.tikomni-hit-score.v5"}
  }
}
