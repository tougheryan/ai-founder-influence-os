# Public address used by the desktop app. Keep this service behind HTTPS in production.
GATEWAY_BIND_HOST=127.0.0.1
GATEWAY_PORT=8787
GATEWAY_DATA_DIR=./data
# Required by compose.yaml/Caddyfile when this is exposed on a public server.
GATEWAY_DOMAIN=gateway.example.com
# Used only by the Tencent CloudBase HTTP-function adapter. Keep the ledger in
# one document; CloudBase transactions serialize quota and nonce mutations.
GATEWAY_CLOUDBASE_COLLECTION=aifios_gateway_ledger
GATEWAY_CLOUDBASE_DOCUMENT_ID=main
# If API Gateway adds a stage prefix (for example /prod), set it here. A
# custom domain that forwards /v1/* directly should leave this empty.
GATEWAY_PATH_PREFIX=
# Exact public origin signed by every desktop request. It must match the URL
# embedded in the hosted desktop build and must not contain a path or trailing
# credentials. Production origins must use HTTPS.
GATEWAY_PUBLIC_ORIGIN=https://gateway.example.com

# Generate both with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
GATEWAY_ADMIN_TOKEN=replace-with-a-long-random-admin-token
GATEWAY_TOKEN_PEPPER=replace-with-a-different-long-random-pepper

# Owner-controlled upstream model configuration. These values never enter the desktop app.
UPSTREAM_API_KIND=openai-compatible
UPSTREAM_API_KEY=replace-with-owner-model-key
UPSTREAM_BASE_URL=https://api.deepseek.com/v1
UPSTREAM_MODEL=deepseek-v4-flash
UPSTREAM_MAX_TOKENS=8000
UPSTREAM_TEMPERATURE=0.7

# Optional server-side TikOmni research for invite-only desktop clients. Keep
# the TikOmni token and the Ed25519 private key on the server. The desktop app
# receives only the matching public key at package time.
TIKOMNI_API_KEY=
TIKOMNI_BASE_URL=https://api.tikomni.com
TIKOMNI_TIMEOUT_MS=14000
# Generate an Ed25519 key pair once, then base64url encode the PKCS#8 private
# DER here and the SPKI public DER in DESKTOP_HOSTED_RESEARCH_PUBLIC_KEY.
GATEWAY_RESEARCH_SIGNING_PRIVATE_KEY_BASE64=
GATEWAY_RESEARCH_SIGNING_KEY_ID=market-v1

# Per-invite defaults. Quota is counted per accepted model request in this beta.
INVITE_DEFAULT_QUOTA=50
SESSION_TTL_DAYS=30
# Device proofs older/newer than this clock-skew window are rejected. Keep the
# server clock synchronized; values above 900 seconds are not accepted.
DEVICE_PROOF_MAX_SKEW_SECONDS=300
ACTIVATION_RATE_LIMIT=12
ACTIVATION_RATE_WINDOW_SECONDS=900
